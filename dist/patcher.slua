function logStatus(message)
  ll.OwnerSay(message)
  statusLog[#statusLog + 1] = message

  if #statusLog > 20 then
    table.remove(statusLog, 1)
  end
end

function pushStatus(message)
  logStatus(message)

  if pollRequestId ~= "" then
    respondPoll()
  end
end

function statusFragment()
  return buildStatusFragment(busy or finishing, completedItems, totalItems, statusLog, isAutoUpdateEnabled())
end

function respondPoll(extraHtml)
  if extraHtml == nil then
    extraHtml = ""
  end

  if pollRequestId == "" then
    return
  end

  respondHtml(pollRequestId, statusFragment() .. extraHtml)
  pollRequestId = ""

  if pollTimer then
    LLTimers:off(pollTimer)
    pollTimer = nil
  end
end

function generateSignedPin()
  local pin = math.floor(math.random() * 2147483646) + 1
  local pinStr = tostring(pin)
  local signature = ll.ComputeHash((SECRET .. "|") .. pinStr, "sha256")

  return { pin = pin, startString = (pinStr .. "|") .. signature }
end

function rezWithSignedPin(objectName)
  local ____generateSignedPin_result_0 = generateSignedPin()
  local pin = ____generateSignedPin_result_0.pin
  local startString = ____generateSignedPin_result_0.startString

  currentPin = pin
  currentObjectId = ll.RezObjectWithParams(objectName, {
    REZ_POS,
    vector.create(0, 0, 1),
    1,
    0,
    REZ_PARAM_STRING,
    startString,
  })
end

function scheduleSelfDelete()
  LLTimers:once(1, function()
    ll.RemoveInventory(SELF_NAME)
  end)
end

function loadNextScript()
  if pendingScriptIdx >= #pendingScripts then
    stopParticles()
    ll.RegionSayTo(currentObjectId, COMM_CHANNEL, "done")

    return
  end

  local script = pendingScripts[pendingScriptIdx + 1]
  local name = targetItemName(script)

  setStatus(
    (
      (((((currentObjectName .. "\nLoading ") .. name) .. "\n[") .. tostring(completedItems)) .. "/")
      .. tostring(totalItems)
    ) .. "]"
  )
  pushStatus((("Loading " .. name) .. " into ") .. currentObjectName)

  ll.RemoteLoadScriptPin(currentObjectId, script, currentPin, 1, 0)
  completedItems = completedItems + 1
  pendingScriptIdx = pendingScriptIdx + 1
  scriptLoadTimer = LLTimers:once(0.5, function()
    scriptLoadTimer = nil
    loadNextScript()
  end)
end

function patchNext()
  if queueIndex >= #patchQueue then
    busy = false
    patchQueue = {}
    patchItemFilter = {}
    queueIndex = 0

    local pending = flushPending()

    if #pending > 0 then
      pushStatus(("Auto-update: patching " .. tostring(#pending)) .. " queued object(s)...")
      startPatching(pending, nil, false)

      return
    end

    clearStatus()

    if completedItems >= totalItems then
      pushStatus("All objects patched.")
    elseif completedItems == 0 then
      pushStatus("Patching failed. All transfers timed out.")
    else
      pushStatus(
        ((("Patching complete. " .. tostring(completedItems)) .. "/") .. tostring(totalItems))
          .. " item(s) transferred."
      )
    end

    return
  end

  local nextName = patchQueue[queueIndex + 1]

  if nextName ~= currentObjectName then
    bootstrapUpgraded = false
  end

  currentObjectName = nextName
  queueIndex = queueIndex + 1

  local ____getItemsForObject_result_1 = getItemsForObject(SELF_NAME, currentObjectName)
  local scripts = ____getItemsForObject_result_1.scripts
  local items = ____getItemsForObject_result_1.items
  local filter = patchItemFilter[currentObjectName]

  if filter and #filter > 0 then
    pendingScripts = __TS__ArrayFilter(scripts, function(____, s)
      return table.find(filter, s) ~= nil
    end)
    pendingItems = __TS__ArrayFilter(items, function(____, it)
      return table.find(filter, it) ~= nil
    end)
  else
    pendingScripts = scripts
    pendingItems = items
  end

  if #pendingScripts == 0 and #pendingItems == 0 then
    pushStatus(("No items found for " .. currentObjectName) .. ", skipping.")
    patchNext()

    return
  end

  setStatus(
    (
      (
        (
          (
            (
              (
                (((currentObjectName .. "\n") .. tostring(#pendingScripts)) .. " script(s), ") .. tostring(
                  #pendingItems
                )
              ) .. " item(s)"
            ) .. "\n["
          ) .. tostring(completedItems)
        ) .. "/"
      ) .. tostring(totalItems)
    ) .. "]"
  )
  pushStatus(
    ((((("Rezzing " .. currentObjectName) .. "... [") .. tostring(completedItems)) .. "/") .. tostring(totalItems))
      .. "]"
  )
  rezWithSignedPin(currentObjectName)

  local timeoutSeconds = #pendingScripts * 3.5 + #pendingItems * 1.5 + 10

  timeoutTimer = LLTimers:once(timeoutSeconds, function()
    stopParticles()

    if scriptLoadTimer then
      LLTimers:off(scriptLoadTimer)
      scriptLoadTimer = nil
    end

    local skipped = #pendingItems - pendingItemIdx + (#pendingScripts - pendingScriptIdx)

    pendingItemIdx = #pendingItems
    pushStatus(
      ((("Timeout waiting for " .. currentObjectName) .. " (") .. tostring(skipped)) .. " item(s) skipped), derezing."
    )
    ll.DerezObject(currentObjectId, DEREZ_TO_INVENTORY)
    timeoutTimer = nil
    patchNext()
  end)
end

function startPatching(queue, itemFilter, resetLog)
  if resetLog == nil then
    resetLog = true
  end

  patchQueue = queue
  patchItemFilter = itemFilter or {}
  queueIndex = 0
  completedItems = 0
  bootstrapUpgraded = false
  busy = true
  totalItems = 0

  for ____, obj in ipairs(queue) do
    local ____getItemsForObject_result_2 = getItemsForObject(SELF_NAME, obj)
    local scripts = ____getItemsForObject_result_2.scripts
    local items = ____getItemsForObject_result_2.items
    local filter = patchItemFilter[obj]

    if filter and #filter > 0 then
      totalItems = totalItems
        + #__TS__ArrayFilter(scripts, function(____, s)
          return table.find(filter, s) ~= nil
        end)
      totalItems = totalItems
        + #__TS__ArrayFilter(items, function(____, it)
          return table.find(filter, it) ~= nil
        end)
    else
      totalItems = totalItems + (#scripts + #items)
    end
  end

  if resetLog then
    statusLog = {}
  end

  pushStatus(((("Patching " .. tostring(totalItems)) .. " item(s) across ") .. tostring(#queue)) .. " object(s)...")
  patchNext()
end

function onAllPinned()
  if cleanupTimer then
    LLTimers:off(cleanupTimer)
    cleanupTimer = nil
  end

  for ____, entry in ipairs(cleanupObjects) do
    if entry.pinned then
      ll.RegionSayTo(entry.id, COMM_CHANNEL, "cleanup")
    else
      pushStatus(entry.name .. " did not respond, derezing.")
    end
  end

  LLTimers:once(3, function()
    for ____, entry in ipairs(cleanupObjects) do
      ll.DerezObject(entry.id, DEREZ_TO_INVENTORY)
    end

    verifyDerez(0)
  end)
end

function verifyDerez(attempt)
  local allGone = true

  for ____, entry in ipairs(cleanupObjects) do
    local details = ll.GetObjectDetails(entry.id, { OBJECT_NAME })

    if #details > 0 then
      allGone = false
      break
    end
  end

  if allGone or attempt >= 4 then
    if not allGone then
      for ____, entry in ipairs(cleanupObjects) do
        local details = ll.GetObjectDetails(entry.id, { OBJECT_NAME })

        if #details > 0 then
          pushStatus(("Warning: " .. entry.name) .. " may not have been derezzed.")
        end
      end
    end

    finishCleanup()
  else
    LLTimers:once(1.5, function()
      verifyDerez(attempt + 1)
    end)
  end
end

function finishCleanup()
  cleanupObjects = {}
  cleanupPinnedCount = 0
  finishing = false
  busy = false
  clearStatus()
  logStatus("Cleanup complete. Goodbye!")

  if pollRequestId ~= "" then
    respondPoll(GOODBYE_FRAGMENT)
    scheduleSelfDelete()
  else
    goodbyePending = true
  end
end

function respondHtml(requestId, body)
  ll.SetContentType(requestId, CONTENT_TYPE_XHTML)
  ll.HTTPResponse(requestId, 200, body)
end

SELF_NAME = ll.GetScriptName()
currentObjectName = ""
patchQueue = {}
patchItemFilter = {}
queueIndex = 0
totalItems = 0
completedItems = 0
bootstrapUpgraded = false
busy = false
finishing = false
cleanupObjects = {}
cleanupPinnedCount = 0
cleanupTimer = nil
goodbyePending = false
currentPin = 0
timeoutTimer = nil
pendingScripts = {}
pendingItems = {}
pendingScriptIdx = 0
pendingItemIdx = 0
scriptLoadTimer = nil

--- The HTTP-in URL assigned by the simulator.
local httpUrl = ""

pollRequestId = ""
pollTimer = nil
statusLog = {}

--- Transfers pending items one at a time using a remove-then-give protocol.
-- Sends "remove|name" to the bootstrap, waits for "removed", then gives
-- the item. This prevents duplicate items on repeated patches.
local function giveNextItem()
  if pendingItemIdx >= #pendingItems then
    pendingScriptIdx = 0
    loadNextScript()

    return
  end

  local item = pendingItems[pendingItemIdx + 1]
  local name = targetItemName(item)

  setStatus(
    (
      (((((currentObjectName .. "\nTransferring ") .. name) .. "\n[") .. tostring(completedItems)) .. "/")
      .. tostring(totalItems)
    ) .. "]"
  )
  pushStatus((("Transferring " .. name) .. " to ") .. currentObjectName)
  ll.RegionSayTo(currentObjectId, COMM_CHANNEL, "remove|" .. item)
end

--- Finds a cleanup entry by uuid.
local function findCleanupEntry(id)
  for ____, entry in ipairs(cleanupObjects) do
    if entry.id == id then
      return entry
    end
  end

  return nil
end

--- Rezzes all objects in parallel, sets a global timeout, and waits for
-- bootstrap "pinned" messages. Once all have pinned (or timeout fires),
-- sends cleanup to all, derezzes, and verifies.
local function startCleanup(objectNames)
  finishing = true
  busy = true
  statusLog = {}
  cleanupObjects = {}
  cleanupPinnedCount = 0
  completedItems = 0
  pushStatus(("Cleaning up " .. tostring(#objectNames)) .. " object(s)...")

  for ____, name in ipairs(objectNames) do
    local ____generateSignedPin_result_3 = generateSignedPin()
    local startString = ____generateSignedPin_result_3.startString
    local id = ll.RezObjectWithParams(name, {
      REZ_POS,
      vector.create(0, 0, 1),
      1,
      0,
      REZ_PARAM_STRING,
      startString,
    })

    if id.istruthy then
      cleanupObjects[#cleanupObjects + 1] = { name = name, id = id, pinned = false }
    else
      pushStatus(("Failed to rez " .. name) .. ", skipping.")
    end
  end

  totalItems = #cleanupObjects

  if #cleanupObjects == 0 then
    pushStatus("No objects could be rezzed.")
    finishCleanup()

    return
  end

  cleanupTimer = LLTimers:once(15, function()
    cleanupTimer = nil
    onAllPinned()
  end)
end

--- Releases the current HTTP-in URL and requests a new one.
local function refreshUrl()
  pollRequestId = ""

  if pollTimer then
    LLTimers:off(pollTimer)
    pollTimer = nil
  end

  if httpUrl ~= "" then
    ll.ReleaseURL(httpUrl)
    httpUrl = ""
  end

  ll.RequestURL()
end

LLEvents:on("http_request", function(requestId, method, body)
  if method == URL_REQUEST_GRANTED then
    httpUrl = body
    ll.OwnerSay("Web UI: " .. httpUrl)

    return
  end

  if method == URL_REQUEST_DENIED then
    ll.OwnerSay("Failed to get HTTP URL: " .. body)

    return
  end

  local url = ll.GetHTTPHeader(requestId, "x-path-info")

  if method == "GET" then
    if url == "" or url == "/" then
      respondHtml(requestId, pageShell(httpUrl, ll.GetObjectName()))
    elseif url == "/app" then
      respondHtml(requestId, appFragment())
    elseif url == "/objects" then
      respondHtml(requestId, buildObjectList(SELF_NAME))
    elseif url == "/poll" then
      if goodbyePending then
        goodbyePending = false

        respondHtml(requestId, statusFragment() .. GOODBYE_FRAGMENT)
        scheduleSelfDelete()

        return
      end

      if pollRequestId ~= "" then
        respondHtml(pollRequestId, buildStatusFragment(busy or finishing, completedItems, totalItems, statusLog))

        if pollTimer then
          LLTimers:off(pollTimer)
          pollTimer = nil
        end
      end

      pollRequestId = requestId
      pollTimer = LLTimers:once(25, function()
        pollTimer = nil
        respondPoll()
      end)
    elseif url == "/autoupdate" then
      respondHtml(requestId, buildAutoUpdateControls(isAutoUpdateEnabled(), getDebounceSeconds()))
    else
      ll.HTTPResponse(requestId, 404, "Not found")
    end
  elseif method == "POST" then
    if url == "/patch" then
      if busy then
        respondHtml(requestId, statusFragment())

        return
      end

      local ____parseFormItems_result_4 = parseFormItems(body)
      local queue = ____parseFormItems_result_4.queue
      local filter = ____parseFormItems_result_4.filter

      if #queue == 0 then
        respondHtml(requestId, "<strong>No items selected</strong>")

        return
      end

      startPatching(queue, filter)

      respondHtml(requestId, statusFragment())
    elseif url == "/patch-all" then
      if busy then
        respondHtml(requestId, statusFragment())

        return
      end

      local queue = {}

      for ____, obj in ipairs(getObjectNames()) do
        local ____getItemsForObject_result_5 = getItemsForObject(SELF_NAME, obj)
        local scripts = ____getItemsForObject_result_5.scripts
        local items = ____getItemsForObject_result_5.items

        if #scripts > 0 or #items > 0 then
          queue[#queue + 1] = obj
        end
      end

      if #queue > 0 then
        startPatching(queue)
      end

      respondHtml(requestId, statusFragment())
    elseif url == "/finish" then
      if busy then
        respondHtml(requestId, statusFragment())

        return
      end

      startCleanup(getObjectNames())

      respondHtml(requestId, statusFragment())
    elseif url == "/autoupdate" then
      local enabling = parseFormValue(body, "enabled") == "on"

      if enabling then
        enableAutoUpdate()
      else
        disableAutoUpdate()
      end

      local html = buildAutoUpdateControls(isAutoUpdateEnabled(), getDebounceSeconds())

      if pollRequestId ~= "" then
        respondPoll()
      end

      respondHtml(requestId, html)
    elseif url == "/autoupdate-debounce" then
      local seconds = tonumber(parseFormValue(body, "debounce") or "")

      if seconds ~= nil and seconds >= 1 and seconds <= 60 then
        setDebounceSeconds(seconds)
      end

      respondHtml(requestId, buildAutoUpdateControls(isAutoUpdateEnabled(), getDebounceSeconds()))
    else
      ll.HTTPResponse(requestId, 404, "Not found")
    end
  else
    ll.HTTPResponse(requestId, 405, "Method not allowed")
  end
end)

LLEvents:on("listen", function(channel, _name, id, message)
  if channel == CMD_CHANNEL then
    if id ~= ll.GetOwner() then
      return
    end

    if message == "url" then
      if httpUrl ~= "" then
        ll.OwnerSay(httpUrl)
      else
        ll.OwnerSay("HTTP URL not yet available.")
      end
    elseif message == "auto" or string.find(message, "auto ", 1, true) == 1 then
      local arg = ll.StringTrim(string.sub(message, 6), STRING_TRIM)

      if arg ~= "" then
        local seconds = tonumber(arg)

        if seconds ~= nil and seconds >= 1 then
          setDebounceSeconds(seconds)
          enableAutoUpdate()
          ll.OwnerSay(("Auto-update enabled (" .. tostring(seconds)) .. "s debounce).")
        else
          ll.OwnerSay("Usage: /7 auto [seconds]")
        end
      elseif isAutoUpdateEnabled() then
        disableAutoUpdate()
        ll.OwnerSay("Auto-update disabled.")
      else
        enableAutoUpdate()
        ll.OwnerSay(("Auto-update enabled (" .. tostring(getDebounceSeconds())) .. "s debounce).")
      end
    end
  elseif channel == COMM_CHANNEL and busy then
    if (message == "pinned" or string.find(message, "pinned|", 1, true) == 1) and finishing then
      local entry = findCleanupEntry(id)

      if entry and not entry.pinned then
        entry.pinned = true
        cleanupPinnedCount = cleanupPinnedCount + 1
        completedItems = completedItems + 1
        logStatus(
          ((((entry.name .. " pinned. [") .. tostring(cleanupPinnedCount)) .. "/") .. tostring(#cleanupObjects)) .. "]"
        )

        if cleanupPinnedCount >= #cleanupObjects then
          onAllPinned()
        end
      end
    elseif
      (message == "pinned" or string.find(message, "pinned|", 1, true) == 1)
      and id == currentObjectId
      and not finishing
    then
      if message == "pinned" then
        if timeoutTimer then
          LLTimers:off(timeoutTimer)
          timeoutTimer = nil
        end

        local hasBootstrap = ll.GetInventoryType(BOOTSTRAP_NAME) == INVENTORY_SCRIPT

        if not bootstrapUpgraded and hasBootstrap then
          bootstrapUpgraded = true
          pushStatus(("Upgrading bootstrap in " .. currentObjectName) .. "...")

          ll.RemoteLoadScriptPin(currentObjectId, BOOTSTRAP_NAME, currentPin, 1, 0)
          ll.DerezObject(currentObjectId, DEREZ_TO_INVENTORY)
          queueIndex = queueIndex - 1

          LLTimers:once(1, function()
            return patchNext()
          end)
        else
          local hint = if not hasBootstrap then ' Add "bootstrap" script to auto-upgrade.' else ""

          pushStatus((("Outdated bootstrap in " .. currentObjectName) .. ", skipping.") .. hint)
          ll.DerezObject(currentObjectId, DEREZ_TO_INVENTORY)
          patchNext()
        end
      else
        if bootstrapUpgraded then
          pushStatus(("Bootstrap upgraded in " .. currentObjectName) .. ".")
        end

        startParticles(currentObjectId)
        pendingItemIdx = 0
        giveNextItem()
      end
    elseif message == "removed" and id == currentObjectId and not finishing and pendingItemIdx < #pendingItems then
      local item = pendingItems[pendingItemIdx + 1]

      ll.GiveInventory(currentObjectId, item)
      completedItems = completedItems + 1
      pendingItemIdx = pendingItemIdx + 1
      giveNextItem()
    elseif message == "cleaned" and finishing then
      local entry = findCleanupEntry(id)

      if entry then
        logStatus(entry.name .. " cleaned.")
      end
    elseif message == "ready" and id == currentObjectId then
      if timeoutTimer then
        LLTimers:off(timeoutTimer)
        timeoutTimer = nil
      end

      if scriptLoadTimer then
        LLTimers:off(scriptLoadTimer)
        scriptLoadTimer = nil
      end

      logStatus(currentObjectName .. " patched successfully.")
      ll.DerezObject(currentObjectId, DEREZ_TO_INVENTORY)
      patchNext()
    end
  end
end)

LLEvents:on("on_rez", function()
  refreshUrl()
end)

LLEvents:on("attach", function()
  refreshUrl()
end)

LLEvents:on("changed", function(change)
  if bit32.btest(change, CHANGED_INVENTORY) then
    onInventoryChanged()
  end

  if bit32.btest(change, bit32.bor(CHANGED_REGION, CHANGED_REGION_START)) then
    refreshUrl()
  end
end)

ll.Listen(CMD_CHANNEL, "", NULL_KEY, "")
ll.Listen(COMM_CHANNEL, "", NULL_KEY, "")
ll.RequestURL()

setupAutoUpdate(SELF_NAME, startPatching, function()
  return busy
end, pushStatus)

do
  local used = ll.GetUsedMemory()
  local limit = ll.GetMemoryLimit()

  ll.OwnerSay(
    (
      (((("Memory: " .. tostring(used // 1024)) .. "KB / ") .. tostring(limit // 1024)) .. "KB (")
      .. tostring(math.floor(used / limit * 100))
    ) .. "%)"
  )
end
