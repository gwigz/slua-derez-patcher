local logStatus, pushStatus, statusFragment, respondPoll, generateSignedPin, derivePin, signMessage, dispatchToWorker, rezWithSignedPin, scheduleSelfDelete, loadNextScript, patchNext, startPatching, onAllPinned, verifyDerez, finishCleanup, respondHtml, SELF_NAME, currentObjectId, currentObjectName, patchQueue, patchItemFilter, queueIndex, totalItems, completedItems, bootstrapUpgraded, busy, finishing, cleanupObjects, cleanupPinnedCount, cleanupTimer, goodbyePending, currentPin, timeoutTimer, pendingScripts, pendingItems, pendingScriptIdx, pendingItemIdx, scriptLoadTimer, workerIndices, workerChannel, workerBusy, workerPendingQueue, currentNonce, pollRequestId, pollTimer, statusLog
local setupAutoUpdate = setup
local isAutoUpdateEnabled = isEnabled
local enableAutoUpdate = enable
local disableAutoUpdate = disable

function logStatus(message)
  ll.OwnerSay(message)
  statusLog[#statusLog + 1] = message

  if #statusLog > 20 then
    table.remove(statusLog, 1)
  end
end

function pushStatus(message)
  logStatus(message)

  if pollRequestId ~= "" then
    respondPoll()
  end
end

function statusFragment()
  return buildStatusFragment(busy or finishing, completedItems, totalItems, statusLog, isAutoUpdateEnabled())
end

function respondPoll(extraHtml)
  if extraHtml == nil then
    extraHtml = ""
  end

  if pollRequestId == "" then
    return
  end

  respondHtml(pollRequestId, statusFragment() .. extraHtml)
  pollRequestId = ""

  if pollTimer then
    LLTimers:off(pollTimer)
    pollTimer = nil
  end
end

function generateSignedPin()
  local pin

  if WORKERS_ENABLED and #workerIndices > 0 then
    currentNonce = ll.GenerateKey()
    pin = derivePin(currentNonce)
  else
    pin = math.floor(math.random() * 2147483646) + 1
  end

  local pinStr = pin
  local signature = ll.ComputeHash((SECRET .. "|") .. pinStr, "sha256")

  return { pin = pin, startString = (pinStr .. "|") .. signature }
end

function derivePin(nonce)
  local hash = ll.ComputeHash((SECRET .. "|") .. tostring(nonce), "sha256")

  return tonumber(string.sub(hash, 1, 8), 16) % 2147483646 + 1
end

function signMessage(payload)
  return string.sub(ll.ComputeHash((SECRET .. "|") .. payload, "sha256"), 1, 16)
end

function dispatchToWorker(pos, script)
  workerBusy[pos + 1] = true

  local idx = workerIndices[pos + 1]
  local payload = (((((("load|" .. tostring(idx)) .. "|") .. script) .. "|") .. tostring(currentNonce)) .. "|")
    .. tostring(currentObjectId)
  local sig = signMessage(payload)

  ll.MessageLinked(
    LINK_THIS,
    workerChannel,
    (((((("load|" .. tostring(idx)) .. "|") .. script) .. "|") .. tostring(currentNonce)) .. "|") .. sig,
    currentObjectId
  )
end

function rezWithSignedPin(objectName)
  local _r2 = generateSignedPin()
  local pin, startString = _r2.pin, _r2.startString

  currentPin = pin
  currentObjectId = ll.RezObjectWithParams(objectName, {
    REZ_POS,
    vector.create(0, 0, 1),
    1,
    0,
    REZ_PARAM_STRING,
    startString,
  })
end

function scheduleSelfDelete()
  LLTimers:once(1, function()
    ll.RemoveInventory(SELF_NAME)
  end)
end

function loadNextScript()
  if pendingScriptIdx >= #pendingScripts then
    stopParticles()
    ll.RegionSayTo(currentObjectId, COMM_CHANNEL, "done")

    return
  end

  if WORKERS_ENABLED and #workerIndices > 0 then
    local remaining = #pendingScripts - pendingScriptIdx

    workerPendingQueue = {}
    do
      local i = pendingScriptIdx

      while i < #pendingScripts do
        workerPendingQueue[#workerPendingQueue + 1] = pendingScripts[i + 1]
        i += 1
      end
    end

    local dispatching = math.min(#workerIndices, #workerPendingQueue)

    do
      local w = 0

      while w < dispatching do
        local script = table.remove(workerPendingQueue, 1)
        local name = targetItemName(script)

        setStatus(
          (
            (((((currentObjectName .. "\nLoading ") .. name) .. "\n[") .. tostring(completedItems)) .. "/")
            .. tostring(totalItems)
          ) .. "]"
        )
        pushStatus((("Loading " .. name) .. " into ") .. currentObjectName)
        dispatchToWorker(w, script)
        w += 1
      end
    end

    if remaining > #workerIndices then
      local script = table.remove(workerPendingQueue, 1)
      local name = targetItemName(script)

      setStatus(
        (
          (((((currentObjectName .. "\nLoading ") .. name) .. "\n[") .. tostring(completedItems)) .. "/")
          .. tostring(totalItems)
        ) .. "]"
      )
      pushStatus((("Loading " .. name) .. " into ") .. currentObjectName)

      ll.RemoteLoadScriptPin(currentObjectId, script, currentPin, 1, 0)
      completedItems += 1

      if #workerPendingQueue > 0 then
        local anyBusy = false

        do
          local i = 0

          while i < #workerIndices do
            if workerBusy[i + 1] then
              anyBusy = true
              break
            end

            i += 1
          end
        end

        if not anyBusy and #workerPendingQueue == 0 then
          stopParticles()
          ll.RegionSayTo(currentObjectId, COMM_CHANNEL, "done")
        end
      end
    end

    pendingScriptIdx = #pendingScripts

    return
  end

  local script = pendingScripts[pendingScriptIdx + 1]
  local name = targetItemName(script)

  setStatus(
    (
      (((((currentObjectName .. "\nLoading ") .. name) .. "\n[") .. tostring(completedItems)) .. "/")
      .. tostring(totalItems)
    ) .. "]"
  )
  pushStatus((("Loading " .. name) .. " into ") .. currentObjectName)

  ll.RemoteLoadScriptPin(currentObjectId, script, currentPin, 1, 0)
  completedItems += 1
  pendingScriptIdx += 1
  scriptLoadTimer = LLTimers:once(0.5, function()
    scriptLoadTimer = nil
    loadNextScript()
  end)
end

function patchNext()
  if queueIndex >= #patchQueue then
    busy = false
    patchQueue = {}
    patchItemFilter = {}
    queueIndex = 0

    local pending = flushPending()

    if #pending > 0 then
      pushStatus(("Auto-update: patching " .. #pending) .. " queued object(s)...")
      startPatching(pending, nil, false)

      return
    end

    clearStatus()

    if completedItems >= totalItems then
      pushStatus("All objects patched.")
    elseif completedItems == 0 then
      pushStatus("Patching failed. All transfers timed out.")
    else
      pushStatus(((("Patching complete. " .. completedItems) .. "/") .. totalItems) .. " item(s) transferred.")
    end

    return
  end

  local nextName = patchQueue[queueIndex + 1]

  if nextName ~= currentObjectName then
    bootstrapUpgraded = false
  end

  currentObjectName = nextName
  queueIndex += 1

  local _r3 = getItemsForObject(SELF_NAME, currentObjectName)
  local scripts, items = _r3.scripts, _r3.items
  local filter = patchItemFilter[currentObjectName]

  if filter and #filter > 0 then
    pendingScripts = __TS__ArrayFilter(scripts, function(____, s)
      return table.find(filter, s) ~= nil
    end)
    pendingItems = __TS__ArrayFilter(items, function(____, it)
      return table.find(filter, it) ~= nil
    end)
  else
    pendingScripts = scripts
    pendingItems = items
  end

  if #pendingScripts == 0 and #pendingItems == 0 then
    pushStatus(("No items found for " .. currentObjectName) .. ", skipping.")
    patchNext()

    return
  end

  setStatus(
    (
      (
        (
          (
            (
              (
                (((currentObjectName .. "\n") .. tostring(#pendingScripts)) .. " script(s), ") .. tostring(
                  #pendingItems
                )
              ) .. " item(s)"
            ) .. "\n["
          ) .. tostring(completedItems)
        ) .. "/"
      ) .. tostring(totalItems)
    ) .. "]"
  )
  pushStatus(((((("Rezzing " .. currentObjectName) .. "... [") .. completedItems) .. "/") .. totalItems) .. "]")
  rezWithSignedPin(currentObjectName)

  local effectiveLoaders = if WORKERS_ENABLED and #workerIndices > 0 then #workerIndices + 1 else 1
  local scriptBatches = math.ceil(#pendingScripts / effectiveLoaders)
  local timeoutSeconds = scriptBatches * 3.5 + #pendingItems * 1.5 + 10

  timeoutTimer = LLTimers:once(timeoutSeconds, function()
    stopParticles()

    if scriptLoadTimer then
      LLTimers:off(scriptLoadTimer)
      scriptLoadTimer = nil
    end

    workerPendingQueue = {}
    do
      local i = 0

      while i < #workerIndices do
        workerBusy[i + 1] = false
        i += 1
      end
    end

    local skipped = #pendingItems - pendingItemIdx + (#pendingScripts - pendingScriptIdx)

    pendingItemIdx = #pendingItems
    pushStatus(((("Timeout waiting for " .. currentObjectName) .. " (") .. skipped) .. " item(s) skipped), derezing.")
    ll.DerezObject(currentObjectId, DEREZ_TO_INVENTORY)
    timeoutTimer = nil
    patchNext()
  end)
end

function startPatching(queue, itemFilter, resetLog)
  if resetLog == nil then
    resetLog = true
  end

  patchQueue = queue
  patchItemFilter = itemFilter or {}
  queueIndex = 0
  completedItems = 0
  bootstrapUpgraded = false
  busy = true
  totalItems = 0

  for ____, obj in ipairs(queue) do
    local _r4 = getItemsForObject(SELF_NAME, obj)
    local scripts, items = _r4.scripts, _r4.items
    local filter = patchItemFilter[obj]

    if filter and #filter > 0 then
      totalItems += #__TS__ArrayFilter(scripts, function(____, s)
        return table.find(filter, s) ~= nil
      end)
      totalItems += #__TS__ArrayFilter(items, function(____, it)
        return table.find(filter, it) ~= nil
      end)
    else
      totalItems = totalItems + (#scripts + #items)
    end
  end

  if resetLog then
    statusLog = {}
  end

  pushStatus(((("Patching " .. totalItems) .. " item(s) across ") .. #queue) .. " object(s)...")
  patchNext()
end

function onAllPinned()
  if cleanupTimer then
    LLTimers:off(cleanupTimer)
    cleanupTimer = nil
  end

  for ____, entry in ipairs(cleanupObjects) do
    if entry.pinned then
      ll.RegionSayTo(entry.id, COMM_CHANNEL, "cleanup")
    else
      pushStatus(entry.name .. " did not respond, derezing.")
    end
  end

  LLTimers:once(3, function()
    for ____, entry in ipairs(cleanupObjects) do
      ll.DerezObject(entry.id, DEREZ_TO_INVENTORY)
    end

    verifyDerez(0)
  end)
end

function verifyDerez(attempt)
  local allGone = true

  for ____, entry in ipairs(cleanupObjects) do
    local details = ll.GetObjectDetails(entry.id, { OBJECT_NAME })

    if #details > 0 then
      allGone = false
      break
    end
  end

  if allGone or attempt >= 4 then
    if not allGone then
      for ____, entry in ipairs(cleanupObjects) do
        local details = ll.GetObjectDetails(entry.id, { OBJECT_NAME })

        if #details > 0 then
          pushStatus(("Warning: " .. entry.name) .. " may not have been derezzed.")
        end
      end
    end

    finishCleanup()
  else
    LLTimers:once(1.5, function()
      verifyDerez(attempt + 1)
    end)
  end
end

function finishCleanup()
  cleanupObjects = {}
  cleanupPinnedCount = 0
  finishing = false
  busy = false
  clearStatus()
  logStatus("Cleanup complete. Goodbye!")

  if pollRequestId ~= "" then
    respondPoll(GOODBYE_FRAGMENT)
    scheduleSelfDelete()
  else
    goodbyePending = true
  end
end

function respondHtml(requestId, body)
  ll.SetContentType(requestId, CONTENT_TYPE_XHTML)
  ll.HTTPResponse(requestId, 200, body)
end

SELF_NAME = ll.GetScriptName()
currentObjectName = ""
patchQueue = {}
patchItemFilter = {}
queueIndex = 0
totalItems = 0
completedItems = 0
bootstrapUpgraded = false
busy = false
finishing = false
cleanupObjects = {}
cleanupPinnedCount = 0
cleanupTimer = nil
goodbyePending = false
currentPin = 0
timeoutTimer = nil
pendingScripts = {}
pendingItems = {}
pendingScriptIdx = 0
pendingItemIdx = 0
scriptLoadTimer = nil
workerIndices = {}
workerChannel = 0
workerBusy = {}
workerPendingQueue = {}

--- The HTTP-in URL assigned by the simulator.
local httpUrl = ""

pollRequestId = ""
pollTimer = nil
statusLog = {}

--- Computes the shared worker channel from SECRET and the linkset root key.
local function computeWorkerChannel()
  local hash = ll.ComputeHash((SECRET .. "|worker|") .. tostring(ll.GetLinkKey(1)), "md5")

  return -tonumber(string.sub(hash, 1, 7), 16)
end

--- Scans inventory for patcher-worker[N] scripts and returns their indices.
local function discoverWorkers()
  if not WORKERS_ENABLED then
    return {}
  end

  local indices = {}
  local total = ll.GetInventoryNumber(INVENTORY_SCRIPT)

  do
    local i = 0

    while i < total do
      local name = ll.GetInventoryName(INVENTORY_SCRIPT, i + 1)

      if string.find(name, "patcher-worker[", 1, true) == 1 then
        local idx = tonumber(string.sub(name, 16, #name - 1))

        if idx ~= nil then
          indices[#indices + 1] = idx
        end
      end

      i += 1
    end
  end

  return indices
end

--- Verifies a truncated keyed hash signature on a payload.
local function verifyMessage(payload, sig)
  return string.sub(ll.ComputeHash((SECRET .. "|") .. payload, "sha256"), 1, 16) == sig
end

--- Handles a worker completion: marks idle, dispatches next script or finishes.
local function onWorkerDone(idx, script)
  local pos = (table.find(workerIndices, idx) or 0) - 1

  if pos < 0 then
    return
  end

  workerBusy[pos + 1] = false
  completedItems += 1

  local name = targetItemName(script)

  pushStatus((("Loaded " .. name) .. " into ") .. currentObjectName)

  if #workerPendingQueue > 0 then
    local next = table.remove(workerPendingQueue, 1)
    local nextName = targetItemName(next)

    setStatus(
      (
        (((((currentObjectName .. "\nLoading ") .. nextName) .. "\n[") .. tostring(completedItems)) .. "/")
        .. tostring(totalItems)
      ) .. "]"
    )
    dispatchToWorker(pos, next)

    return
  end

  do
    local i = 0

    while i < #workerIndices do
      if workerBusy[i + 1] then
        return
      end

      i += 1
    end
  end

  stopParticles()
  ll.RegionSayTo(currentObjectId, COMM_CHANNEL, "done")
end

--- Transfers pending items one at a time using a remove-then-give protocol.
-- Sends "remove|name" to the bootstrap, waits for "removed", then gives
-- the item. This prevents duplicate items on repeated patches.
local function giveNextItem()
  if pendingItemIdx >= #pendingItems then
    pendingScriptIdx = 0
    loadNextScript()

    return
  end

  local item = pendingItems[pendingItemIdx + 1]
  local name = targetItemName(item)

  setStatus(
    (
      (((((currentObjectName .. "\nTransferring ") .. name) .. "\n[") .. tostring(completedItems)) .. "/")
      .. tostring(totalItems)
    ) .. "]"
  )
  pushStatus((("Transferring " .. name) .. " to ") .. currentObjectName)
  ll.RegionSayTo(currentObjectId, COMM_CHANNEL, "remove|" .. item)
end

--- Finds a cleanup entry by uuid.
local function findCleanupEntry(id)
  for ____, entry in ipairs(cleanupObjects) do
    if entry.id == id then
      return entry
    end
  end

  return nil
end

--- Rezzes all objects in parallel, sets a global timeout, and waits for
-- bootstrap "pinned" messages. Once all have pinned (or timeout fires),
-- sends cleanup to all, derezzes, and verifies.
local function startCleanup(objectNames)
  finishing = true
  busy = true
  statusLog = {}
  cleanupObjects = {}
  cleanupPinnedCount = 0
  completedItems = 0
  pushStatus(("Cleaning up " .. #objectNames) .. " object(s)...")

  for ____, name in ipairs(objectNames) do
    local _r5 = generateSignedPin()
    local startString = _r5.startString
    local id = ll.RezObjectWithParams(name, {
      REZ_POS,
      vector.create(0, 0, 1),
      1,
      0,
      REZ_PARAM_STRING,
      startString,
    })

    if id.istruthy then
      cleanupObjects[#cleanupObjects + 1] = { name = name, id = id, pinned = false }
    else
      pushStatus(("Failed to rez " .. name) .. ", skipping.")
    end
  end

  totalItems = #cleanupObjects

  if #cleanupObjects == 0 then
    pushStatus("No objects could be rezzed.")
    finishCleanup()

    return
  end

  cleanupTimer = LLTimers:once(15, function()
    cleanupTimer = nil
    onAllPinned()
  end)
end

--- Releases the current HTTP-in URL and requests a new one.
local function refreshUrl()
  pollRequestId = ""

  if pollTimer then
    LLTimers:off(pollTimer)
    pollTimer = nil
  end

  if httpUrl ~= "" then
    ll.ReleaseURL(httpUrl)
    httpUrl = ""
  end

  ll.RequestURL()
end

LLEvents:on("http_request", function(requestId, method, body)
  if method == URL_REQUEST_GRANTED then
    httpUrl = body
    ll.OwnerSay("Web UI: " .. httpUrl)

    return
  end

  if method == URL_REQUEST_DENIED then
    ll.OwnerSay("Failed to get HTTP URL: " .. body)

    return
  end

  local url = ll.GetHTTPHeader(requestId, "x-path-info")

  if method == "GET" then
    if url == "" or url == "/" then
      respondHtml(requestId, pageShell(httpUrl, ll.GetObjectName()))
    elseif url == "/app" then
      respondHtml(requestId, appFragment())
    elseif url == "/objects" then
      respondHtml(requestId, buildObjectList(SELF_NAME))
    elseif url == "/poll" then
      if goodbyePending then
        goodbyePending = false

        respondHtml(requestId, statusFragment() .. GOODBYE_FRAGMENT)
        scheduleSelfDelete()

        return
      end

      if pollRequestId ~= "" then
        respondHtml(pollRequestId, buildStatusFragment(busy or finishing, completedItems, totalItems, statusLog))

        if pollTimer then
          LLTimers:off(pollTimer)
          pollTimer = nil
        end
      end

      pollRequestId = requestId
      pollTimer = LLTimers:once(25, function()
        pollTimer = nil
        respondPoll()
      end)
    elseif url == "/autoupdate" then
      respondHtml(requestId, buildAutoUpdateControls(isAutoUpdateEnabled(), getDebounceSeconds()))
    else
      ll.HTTPResponse(requestId, 404, "Not found")
    end
  elseif method == "POST" then
    if url == "/patch" then
      if busy then
        respondHtml(requestId, statusFragment())

        return
      end

      local _r6 = parseFormItems(body)
      local queue, filter = _r6.queue, _r6.filter

      if #queue == 0 then
        respondHtml(requestId, NO_ITEMS_SELECTED)

        return
      end

      startPatching(queue, filter)

      respondHtml(requestId, statusFragment())
    elseif url == "/patch-all" then
      if busy then
        respondHtml(requestId, statusFragment())

        return
      end

      local queue = {}

      for ____, obj in ipairs(getObjectNames()) do
        local _r7 = getItemsForObject(SELF_NAME, obj)
        local scripts, items = _r7.scripts, _r7.items

        if #scripts > 0 or #items > 0 then
          queue[#queue + 1] = obj
        end
      end

      if #queue > 0 then
        startPatching(queue)
      end

      respondHtml(requestId, statusFragment())
    elseif url == "/finish" then
      if busy then
        respondHtml(requestId, statusFragment())

        return
      end

      startCleanup(getObjectNames())

      respondHtml(requestId, statusFragment())
    elseif url == "/autoupdate" then
      local enabling = parseFormValue(body, "enabled") == "on"

      if enabling then
        enableAutoUpdate()
      else
        disableAutoUpdate()
      end

      local html = buildAutoUpdateControls(isAutoUpdateEnabled(), getDebounceSeconds())

      if pollRequestId ~= "" then
        respondPoll()
      end

      respondHtml(requestId, html)
    elseif url == "/autoupdate-debounce" then
      local seconds = tonumber(parseFormValue(body, "debounce") or "")

      if seconds ~= nil and seconds >= 1 and seconds <= 60 then
        setDebounceSeconds(seconds)
      end

      respondHtml(requestId, buildAutoUpdateControls(isAutoUpdateEnabled(), getDebounceSeconds()))
    else
      ll.HTTPResponse(requestId, 404, "Not found")
    end
  else
    ll.HTTPResponse(requestId, 405, "Method not allowed")
  end
end)

LLEvents:on("listen", function(channel, _name, id, message)
  if channel == CMD_CHANNEL then
    if id ~= ll.GetOwner() then
      return
    end

    if message == "url" then
      if httpUrl ~= "" then
        ll.OwnerSay(httpUrl)
      else
        ll.OwnerSay("HTTP URL not yet available.")
      end
    elseif message == "auto" or string.find(message, "auto ", 1, true) == 1 then
      local arg = ll.StringTrim(string.sub(message, 6), STRING_TRIM)

      if arg ~= "" then
        local seconds = tonumber(arg)

        if seconds ~= nil and seconds >= 1 then
          setDebounceSeconds(seconds)
          enableAutoUpdate()
          ll.OwnerSay(("Auto-update enabled (" .. seconds) .. "s debounce).")
        else
          ll.OwnerSay("Usage: /7 auto [seconds]")
        end
      elseif isAutoUpdateEnabled() then
        disableAutoUpdate()
        ll.OwnerSay("Auto-update disabled.")
      else
        enableAutoUpdate()
        ll.OwnerSay(("Auto-update enabled (" .. getDebounceSeconds()) .. "s debounce).")
      end
    end
  elseif channel == COMM_CHANNEL and busy then
    if (message == "pinned" or string.find(message, "pinned|", 1, true) == 1) and finishing then
      local entry = findCleanupEntry(id)

      if entry and not entry.pinned then
        entry.pinned = true
        cleanupPinnedCount += 1
        completedItems += 1
        logStatus(((((entry.name .. " pinned. [") .. cleanupPinnedCount) .. "/") .. #cleanupObjects) .. "]")

        if cleanupPinnedCount >= #cleanupObjects then
          onAllPinned()
        end
      end
    elseif
      (message == "pinned" or string.find(message, "pinned|", 1, true) == 1)
      and id == currentObjectId
      and not finishing
    then
      if message == "pinned" then
        if timeoutTimer then
          LLTimers:off(timeoutTimer)
          timeoutTimer = nil
        end

        local hasBootstrap = ll.GetInventoryType(BOOTSTRAP_NAME) == INVENTORY_SCRIPT

        if not bootstrapUpgraded and hasBootstrap then
          bootstrapUpgraded = true

          pushStatus(("Upgrading patcher-bootstrap in " .. currentObjectName) .. "...")

          ll.RemoteLoadScriptPin(currentObjectId, BOOTSTRAP_NAME, currentPin, 1, 0)
          ll.DerezObject(currentObjectId, DEREZ_TO_INVENTORY)

          queueIndex -= 1

          LLTimers:once(1, function()
            return patchNext()
          end)
        else
          local hint = if not hasBootstrap then (' Add "' .. BOOTSTRAP_NAME) .. '" script to auto-upgrade.' else ""

          pushStatus((("Outdated patcher-bootstrap in " .. currentObjectName) .. ", skipping.") .. hint)
          ll.DerezObject(currentObjectId, DEREZ_TO_INVENTORY)
          patchNext()
        end
      else
        if bootstrapUpgraded then
          pushStatus(("Patcher-bootstrap upgraded in " .. currentObjectName) .. ".")
        end

        startParticles(currentObjectId)
        pendingItemIdx = 0
        giveNextItem()
      end
    elseif message == "removed" and id == currentObjectId and not finishing and pendingItemIdx < #pendingItems then
      local item = pendingItems[pendingItemIdx + 1]

      ll.GiveInventory(currentObjectId, item)
      completedItems += 1
      pendingItemIdx += 1
      giveNextItem()
    elseif message == "cleaned" and finishing then
      local entry = findCleanupEntry(id)

      if entry then
        logStatus(entry.name .. " cleaned.")
      end
    elseif message == "ready" and id == currentObjectId then
      if timeoutTimer then
        LLTimers:off(timeoutTimer)
        timeoutTimer = nil
      end

      if scriptLoadTimer then
        LLTimers:off(scriptLoadTimer)
        scriptLoadTimer = nil
      end

      logStatus(currentObjectName .. " patched successfully.")
      ll.DerezObject(currentObjectId, DEREZ_TO_INVENTORY)
      patchNext()
    end
  end
end)

if WORKERS_ENABLED then
  LLEvents:on("link_message", function(_sender, num, str, key)
    if num ~= workerChannel or not busy or finishing then
      return
    end

    local parts = string.split(str, "|")

    if #parts < 4 or parts[1] ~= "done" then
      return
    end

    local idx = tonumber(parts[2])

    if idx == nil or not (table.find(workerIndices, idx) ~= nil) then
      return
    end

    local scriptName = parts[3]
    local signature = parts[4]
    local targetId = key
    local expectedPayload = (((("done|" .. parts[2]) .. "|") .. scriptName) .. "|") .. tostring(targetId)

    if not verifyMessage(expectedPayload, signature) then
      return
    end

    onWorkerDone(idx, scriptName)
  end)
end

LLEvents:on("on_rez", function()
  refreshUrl()

  if WORKERS_ENABLED and #workerIndices > 0 then
    workerChannel = computeWorkerChannel()
  end
end)

LLEvents:on("attach", function()
  refreshUrl()
end)

LLEvents:on("changed", function(change)
  if bit32.btest(change, CHANGED_INVENTORY) then
    onInventoryChanged()
    workerIndices = discoverWorkers()
  end

  if bit32.btest(change, bit32.bor(CHANGED_REGION, CHANGED_REGION_START)) then
    refreshUrl()
  end
end)

ll.Listen(CMD_CHANNEL, "", NULL_KEY, "")
ll.Listen(COMM_CHANNEL, "", NULL_KEY, "")
ll.RequestURL()
workerIndices = discoverWorkers()

if #workerIndices > 0 then
  workerChannel = computeWorkerChannel()
  workerBusy = {}
  do
    local i = 0

    while i < #workerIndices do
      workerBusy[#workerBusy + 1] = false
      i += 1
    end
  end

  ll.OwnerSay(("Workers: " .. #workerIndices) .. " patcher-worker script(s) detected.")
end

setupAutoUpdate(SELF_NAME, startPatching, function()
  return busy
end, pushStatus)

do
  local used = ll.GetUsedMemory()
  local limit = ll.GetMemoryLimit()

  ll.OwnerSay(((((("Memory: " .. used // 1024) .. "KB / ") .. limit // 1024) .. "KB (") .. used * 100 // limit) .. "%)")
end
