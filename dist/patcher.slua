local function appFragment()
  return '<form x-data="patcher"><div row=""><label><input type="checkbox" x-bind:checked="allChecked" x-on:click="toggleAll()"/> All</label><b spacer=""></b><button type="submit" sm="" hx-post="patch" hx-target="#c" x-show="items.length" x-bind:disabled="items.length === 0"><i data-lucide="play"></i> Patch</button><button type="button" sm="" hx-post="patch-all" hx-target="#c"><i data-lucide="layers"></i> Patch All</button><button type="button" sm="" secondary="" hx-get="objects" hx-target="#b"><i data-lucide="refresh-cw"></i></button></div><article id="b" flush="" hx-get="objects" hx-trigger="load" x-on:change="sync()" x-on:htmx:after-swap.camel="sync()"><article aria-busy="true" align="center"></article></article></form><div id="a" hx-get="autoupdate" hx-trigger="load"></div><article flush=""><header>Status</header><div id="c" row="">Ready</div></article><div align="center" x-data="{ confirmText: \'\' }"><button type="button" sm="" destructive="" x-on:click="$refs.fd.showModal()">Remove patcher scripts…</button><dialog align="left" x-ref="fd"><header><h3>Remove patcher scripts?</h3><p>This will remove the bootstrap script from every target object, then delete the patcher script.</p></header><div stack="xs"><label for="confirmText">Type FINISH to confirm</label><input type="text" id="confirmText" x-model="confirmText" placeholder="FINISH" autocomplete="off"/></div><footer><button type="button" secondary="" x-on:click="confirmText=\'\';$refs.fd.close()">Cancel</button><button type="button" hx-post="finish" hx-target="#c" destructive="" x-bind:disabled="confirmText.toUpperCase() !== \'FINISH\'" x-on:click="confirmText=\'\';$refs.fd.close()">Confirm</button></footer></dialog></div>'
end

local EMPTY_STATE = '<article empty=""><b>No patchable objects found in inventory.</b></article>'

local POLL_TRIGGER = '<div style="display:none" hx-get="poll" hx-trigger="load" hx-target="#c"></div>'

--- Escapes HTML special characters to prevent XSS.
local function escapeHtml(s)
  return ll.ReplaceSubString(

    ll.ReplaceSubString(ll.ReplaceSubString(ll.ReplaceSubString(s, "&", "&amp;", 0), "<", "&lt;", 0), ">", "&gt;", 0),
    '"',
    "&quot;",
    0
  )
end

--- Builds an inventory row with a type-specific badge.
local function buildItemRow(fullItemName)
  local typeLabel = inventoryTypeLabel(ll.GetInventoryType(fullItemName))
  local escaped = escapeHtml(fullItemName)
  local itemName = escapeHtml(targetItemName(fullItemName))

  return (
    (
      (
        (
          (
            (
              ('<label class="c" row=""><input type="checkbox" name="item" value="' .. escaped)
              .. '" x-on:change="sync()"/><b spacer="" truncate="" tooltip-top="'
            ) .. itemName
          ) .. '">'
        ) .. itemName
      ) .. '</b><kbd outline="">'
    ) .. typeLabel
  ) .. "</kbd></label>"
end

--- Builds the object list HTML with expandable groups and per-item checkboxes.
-- Each item checkbox has name="item" value="ObjectName/item-name".
local function buildObjectList(selfName)
  local objects = getObjectNames()
  local html = ""

  for ____, obj in ipairs(objects) do
    local ____getItemsForObject_result_0 = getItemsForObject(selfName, obj)
    local scripts = ____getItemsForObject_result_0.scripts
    local items = ____getItemsForObject_result_0.items

    if #scripts > 0 or #items > 0 then
      local escaped = escapeHtml(obj)
      local itemsHtml = ""

      for ____, script in ipairs(scripts) do
        itemsHtml = itemsHtml .. buildItemRow(script)
      end

      for ____, item in ipairs(items) do
        itemsHtml = itemsHtml .. buildItemRow(item)
      end

      html = html
        .. ((((((('<details class="b" left=""><summary><div class="a" row="" spacer=""><input type="checkbox" x-on:click.stop="' .. ("toggleObject('" .. escaped) .. "')") .. '"/><strong class="d" spacer="" truncate="" tooltip-top="') .. escaped) .. '">') .. escaped) .. "</strong></div></summary><div>") .. itemsHtml)
        .. "</div></details>"
    end
  end

  if html == "" then
    return EMPTY_STATE
  end

  return html
end

--- Builds a status fragment showing current patch progress.
-- Includes an hx-get="poll" trigger to continue long polling while busy
-- or when autoupdate is enabled (so status updates push immediately).
local function buildStatusFragment(busy, index, total, log, autoUpdate)
  if autoUpdate == nil then
    autoUpdate = false
  end

  local html = ""

  if busy then
    html = html
      .. ((((((("<strong>Patching " .. tostring(index)) .. "/") .. tostring(total)) .. '</strong><progress value="') .. tostring(
        index
      )) .. '" max="') .. tostring(total))
      .. '"></progress>'
  elseif total > 0 then
    html = html
      .. ((((("" .. "<strong>Done</strong>") .. '<progress value="') .. tostring(total)) .. '" max="') .. tostring(
        total
      ))
      .. '"></progress>'
  else
    html = html .. "<strong>Done</strong>"
  end

  if #log > 0 then
    local logHtml = ""

    for ____, entry in ipairs(log) do
      logHtml = logHtml .. ("<p>" .. escapeHtml(entry)) .. "</p>"
    end

    html = html .. ("<samp>" .. logHtml) .. "</samp>"
  end

  if busy or autoUpdate then
    html = html .. POLL_TRIGGER
  end

  return html
end

--- Decodes a single URL-encoded value (+ -> space, %XX -> char).
-- Collects parts into an array and joins once to avoid O(N²) string concat.
local function urlDecode(encoded)
  local result = (string.gsub(encoded, "+", " "))
  local parts = {}
  local len = #result
  local i = 1

  while i <= len do
    local ch = string.sub(result, i, i)

    if ch == "%" and i + 2 <= len then
      local hex = string.sub(result, i + 1, i + 2)
      local match = string.find(hex, "^%x%x$")

      if match then
        parts[#parts + 1] = string.char(tonumber(hex, 16))
        i = i + 3
      else
        parts[#parts + 1] = ch
        i = i + 1
      end
    else
      parts[#parts + 1] = ch
      i = i + 1
    end
  end

  return table.concat(parts, "")
end

--- Extracts the first value for a given key from a URL-encoded form body.
local function parseFormValue(body, key)
  for ____, pair in ipairs(string.split(body, "&")) do
    local eqIdx = (string.find(pair, "=", 1, true) or 0) - 1

    if eqIdx >= 0 and string.sub(pair, 1, eqIdx) == key then
      return urlDecode(string.sub(pair, eqIdx + 1 + 1))
    end
  end

  return nil
end

--- Parses URL-encoded form body to extract selected item names.
-- Body format: "item=ObjName/script.slua&item=ObjName/other.slua"
--
-- Returns an ordered queue of unique object names and a filter map of
-- object name -> selected full item names.
local function parseFormItems(body)
  local filter = {}
  local queue = {}
  local objects = getObjectNames()

  for ____, pair in ipairs(string.split(body, "&")) do
    local eqIdx = (string.find(pair, "=", 1, true) or 0) - 1

    if eqIdx < 0 then
    else
      local key = string.sub(pair, 1, eqIdx)

      if key == "item" then
        local fullName = urlDecode(string.sub(pair, eqIdx + 1 + 1))
        local slashIdx = (string.find(fullName, "/", 1, true) or 0) - 1

        if slashIdx >= 0 then
          local prefix = string.sub(fullName, 1, slashIdx)

          if string.find(prefix, "{", 1, true) == 1 and (string.find(prefix, "}", 1, true) or 0) - 1 == #prefix - 1 then
            local pattern = string.sub(prefix, 2, #prefix - 1)

            for ____, obj in ipairs(objects) do
              if patternMatches(obj, pattern) then
                if filter[obj] == nil then
                  filter[obj] = {}
                  queue[#queue + 1] = obj
                end

                local ____filter_obj_1 = filter[obj]

                ____filter_obj_1[#____filter_obj_1 + 1] = fullName
              end
            end
          else
            if filter[prefix] == nil then
              filter[prefix] = {}
              queue[#queue + 1] = prefix
            end

            local ____filter_prefix_2 = filter[prefix]

            ____filter_prefix_2[#____filter_prefix_2 + 1] = fullName
          end
        end
      end
    end
  end

  return { queue = queue, filter = filter }
end

--- Goodbye message shown after cleanup finishes. OOB swap replaces `<main>` content.
local GOODBYE_FRAGMENT =
  '<main hx-swap-oob="innerHTML:main"><article empty=""><i data-lucide="circle-check" color="success"></i><h2>All done!</h2><b>Bootstrap scripts have been removed from your objects, you can close this page</b></article></main>'

--- Builds the autoupdate controls reflecting current server state.
-- Returned for GET /autoupdate and POST /autoupdate.
local function buildAutoUpdateControls(enabled, debounce)
  local html = (
    (
      (
        '<article flush=""><header>Settings</header><div row=""><label spacer=""><input type="checkbox" name="enabled"'
        .. if enabled then ' checked=""' else ""
      )
      .. ' hx-post="autoupdate" hx-target="#a"/> Auto-update</label><label>Delay <input type="number" sm="" style="width:3.5rem" name="debounce" value="'
    ) .. tostring(debounce)
  )
    .. '" min="1" max="60" hx-post="autoupdate-debounce" hx-target="#a" hx-trigger="change delay:500ms"/> s</label></div></article>'

  if enabled then
    html = html .. POLL_TRIGGER
  end

  return html
end

-- Lua Library inline imports
local function __TS__ArrayFilter(self, callbackfn, thisArg)
  local result = {}
  local len = 0

  for i = 1, #self do
    if callbackfn(thisArg, self[i], i - 1, self) then
      len = len + 1
      result[len] = self[i]
    end
  end

  return result
end

